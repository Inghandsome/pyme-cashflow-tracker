# Copia este archivo como `.env` y ajusta los valores.
# El archivo `.env` NUNCA se sube al repositorio (ya está en .gitignore).

# ─── Entorno ───
FLASK_ENV=development

# ─── Secretos ───
# Cámbialos por cadenas largas y aleatorias antes de desplegar.
# En producción (Render) son OBLIGATORIOS y se configuran como variables de entorno.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_SECRET_KEY=dev-jwt-secret-key-for-local-development-only

# Horas que dura la sesión antes de pedir el login otra vez.
JWT_HORAS=12

# ─── Base de datos ───
# En desarrollo puedes omitirla: se usa SQLite en backend/instance/muebleria.db
# En producción Render inyecta esta variable automáticamente.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos

# ─── CORS ───
# Orígenes permitidos, separados por comas (el puerto de Vite en desarrollo).
CORS_ORIGINS=http://localhost:5173

# ─── Zona horaria del negocio ───
# Define qué cuenta como "hoy" para el filtro diario del cajero.
ZONA_HORARIA=America/Mexico_City

# ─── Datos iniciales que crea `flask seed` ───
EMPRESA_NOMBRE=Mueblería
EMPRESA_TELEFONO=
DUENO_NOMBRE=Dueño de la mueblería
DUENO_EMAIL=dueno@muebleria.com
DUENO_PASSWORD=CambiarEsta123
